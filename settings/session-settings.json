{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(dropdb:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "bash -c 'source \"$HOME/new-session.sh\" 2>/dev/null; if command -v emit_notification_event >/dev/null 2>&1; then emit_notification_event; elif command -v emit_hook_event >/dev/null 2>&1; then emit_hook_event needs_input; fi'" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash -c 'source \"$HOME/new-session.sh\" 2>/dev/null; command -v emit_hook_event >/dev/null 2>&1 && emit_hook_event input_received'" }
        ]
      }
    ]
  }
}

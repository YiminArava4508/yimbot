# Prefer `pnpm onboard` (interactive wizard, validates against Linear, writes
# this file). This template is for manual editing / reference.
LINEAR_API_KEY=            # personal API key: Linear > Settings > Account > Security & Access
# LINEAR_TEAM_NAME=Engineering
# DEPLOY_STATE_NAME=In Progress         # entering this state deploys a new session (legacy: TRIGGER_STATE_NAME)
# REVIEW_STATE_NAME=In Review           # entering this state flags the session ready to test (a tmux glyph)
# HEARTBEAT_INTERVAL_MINUTES=3          # how often the central loop checks the board (legacy: POLL_INTERVAL_MINUTES)
# YIMBOT_FIX_REAP_STALE_MINUTES=90      # how long a PR fix session may linger before the reaper tears it down as stale
# CODEBASE_PATH=/home/ymbo/Work/gemini   # absolute path; git pull --rebase origin main every poll; also the repo gh reads for the review step

# --- Session models (Claude Code model alias or id) ---
# PLAN_MODEL=opus                         # model the planning session runs on
# IMPL_MODEL=sonnet                       # model the implementation subagents run on

# --- Autonomous claim step ---
# AUTO_CLAIM=true                         # set to "false" to disable auto-claiming (on by default; legacy: AUTO_PICK)
# TODO_STATE_NAME=Todo                    # the "ready to work" state the claim step draws from
# RISK_LABELS=migration,infra,security,breaking   # labels that are never auto-claimed (left for manual start)
# MAX_IN_PROGRESS=3                       # WIP cap: stop claiming once this many are In Progress (1 = one at a time)
# LABEL_FILTER=                           # scope this instance: blank works every ticket, "bot" works only tickets labelled bot, "!bot" works everything except them. Two daemons on one Linear account partition the board by running opposite filters

# --- Cleanup step ---
# AUTO_CLEANUP=true                       # set to "false" to disable; when on, a worktree + session is torn down once its PR merges
# SESSION_TEARDOWN_HOOK=                  # optional script run by end-session.sh before removing a worktree (stop containers, free ports); receives "<worktree_path> <name>"

# --- Advance step ---
# AUTO_CONTINUE=true                      # set to "false" to disable auto-continuation; when on, merged PRs are judged against the issue ACs and a continuation session is spawned while criteria remain
# MAX_CONTINUATIONS=5                     # max continuation rounds per issue before halting for a human
# AC_JUDGE_MODEL=                         # model the AC judge runs on (empty = claude default)

# --- Ready step ---
# AUTO_READY_LABEL=true                   # set to "false" to disable; when on, a "ready-to-merge" label is added to each clean open PR (no unresolved threads, mergeable, CI passing/none) and removed again only on a hard regression (unresolved thread, merge conflict, or failing CI); a merely-pending CI or unknown mergeable state holds the label as-is
# READY_MERGE_LABEL=ready-to-merge        # name of the label to sync (must already exist in the repo)
# IGNORE_CHECKS=                          # comma-separated check names (CheckRun name or status context, case-insensitive) to drop from every CI rollup read; set to your merge queue's own gating check (e.g. aviator/checks) so it never keeps CI perpetually pending and deadlocks the ready label

# The review step (addressing comments on your open PRs) and the cleanup step
# (removing merged PRs' worktrees) have no other settings: both run every
# heartbeat against the repo gh resolves from CODEBASE_PATH, and need `gh`
# installed and authenticated.

# TUI ticket board
# Structured event stream the board reads (self-truncating ring).
# EVENTS_LOG=events.jsonl
# Max lines kept in the ring.
# EVENTS_LOG_MAX_LINES=500
# How long a merged row stays on the board before it ages out (ms).
# TUI_KEEP_MERGED_MS=300000
# Hard cap on board rows.
# TUI_MAX_ROWS=100
# tmux key (in the prefix table) that switches back to the board from any session.
# TUI_RETURN_KEY=Y
# Where daemon logs go when the board owns the terminal.
# DAEMON_LOG=daemon.log
